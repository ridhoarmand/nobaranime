{
  "name": "nobaranime-app",
  "version": "2.0.0",
  "description": "NobarAnime (Otakudesu Clone)",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm --prefix client run dev\" \"bun --cwd server dev\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "bun --cwd server dev",
    "dev:agent": "bun --cwd server dev:agent",
    "build": "npm --prefix client run build && bun --cwd server build",
    "build:client": "npm --prefix client run build",
    "build:server": "bun --cwd server build",
    "start": "bun --cwd server dist/index.js",
    "start:api": "bun --cwd server dist/index.js",
    "start:agent": "bun --cwd server dist/agent.js",
    "db:push": "bun --cwd server db:push",
    "db:generate": "bun --cwd server db:generate",
    "db:studio": "bun --cwd server db:studio",
    "agent:check": "bun --cwd server src/agent.ts --check",
    "agent:ongoing": "bun --cwd server src/agent.ts --ongoing",
    "agent:schedule": "bun --cwd server src/agent.ts --schedule"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
